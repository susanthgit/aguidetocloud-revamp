      "y": 220,
      "width": 651.0,
      "height": 187.5,
      "text": "Survey comments + survey context\nSupported ad-hoc and recurring surveys\nExisting confidentiality rules still apply",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#000000",
