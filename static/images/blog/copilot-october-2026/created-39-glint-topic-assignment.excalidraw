    {
      "id": "text-10",
      "type": "text",
      "x": 90,
      "y": 422,
      "width": 228.16,
      "height": 57.5,
      "text": "VIEW THE RESULTS",
      "fontSize": 23,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-11",
      "type": "text",
      "x": 90,
      "y": 467,
      "width": 886.6,
      "height": 130.0,
      "text": "Reports  >  Comments  >  Topics\nReview the related comments before drawing conclusions.",
      "fontSize": 26,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-12",
      "type": "text",
      "x": 60,
      "y": 574,
      "width": 1031.68,
      "height": 65.0,
      "text": "Not a new chat prompt. Not a reprocessing of historical reports.",
      "fontSize": 26,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-13",
      "type": "text",
      "x": 60,
      "y": 622,
      "width": 1101.12,
      "height": 60.0,
      "text": "Topic assignment can be wrong; it is not a basis for employment decisions.",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-14",
      "type": "text",
      "x": 60,
      "y": 674,
      "width": 1240.0,
      "height": 50.0,
      "text": "Source: Microsoft Learn, Use Viva Glint's Comments report. No employee data or sample metrics shown.",
      "fontSize": 20,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    }
