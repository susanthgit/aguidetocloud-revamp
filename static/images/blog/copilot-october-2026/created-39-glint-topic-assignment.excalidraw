      "y": 174,
      "width": 385.02,
      "height": 57.5,
      "text": "COPILOT-ENHANCED ASSIGNMENT",
      "fontSize": 23,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-8",
      "type": "text",
      "x": 765,
      "y": 220,
      "width": 651.0,
      "height": 187.5,
      "text": "Classifies comments into approved topics\nUses the existing org-wide Copilot setting\nNo separate topic-assignment toggle",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box-9",
      "type": "rectangle",
      "x": 60,
