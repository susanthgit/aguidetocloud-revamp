      "height": 60.0,
      "text": "DURING THE MEETING",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-4",
      "type": "text",
      "x": 90,
      "y": 236,
      "width": 624.96,
      "height": 180.0,
      "text": "Live meeting context generates a summary\nTemporary transcription data is processed\nThe service cache is purged within one day",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
