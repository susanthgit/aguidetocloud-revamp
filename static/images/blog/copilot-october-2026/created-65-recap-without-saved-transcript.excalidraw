      "width": 252.96,
      "height": 60.0,
      "text": "AFTER THE MEETING",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-7",
      "type": "text",
      "x": 765,
      "y": 236,
      "width": 520.8,
      "height": 240.0,
      "text": "AI summary available from Recap\nRead-only Word document in OneDrive\nNo saved transcript or recording\nas part of this experience",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "box-8",
      "type": "rectangle",
      "x": 60,
