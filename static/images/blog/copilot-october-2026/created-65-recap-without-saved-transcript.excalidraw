    },
    {
      "id": "text-9",
      "type": "text",
      "x": 90,
      "y": 451,
      "width": 619.38,
      "height": 67.5,
      "text": "A summary is still a retained record.",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-10",
      "type": "text",
      "x": 90,
      "y": 495,
      "width": 899.0,
      "height": 62.5,
      "text": "Review its access, expiration and compliance requirements.",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-11",
      "type": "text",
      "x": 60,
      "y": 576,
      "width": 1324.32,
      "height": 60.0,
      "text": "Requires a Copilot-licensed organiser, supported meeting policy and feature availability.",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-12",
      "type": "text",
      "x": 60,
      "y": 621,
      "width": 1130.8799999999999,
      "height": 60.0,
      "text": "We could not find the option in our environments; this is not a tenant test.",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
