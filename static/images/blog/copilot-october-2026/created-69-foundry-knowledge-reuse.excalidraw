      "verticalAlign": "top"
    },
    {
      "id": "t10",
      "type": "text",
      "x": 1063,
      "y": 335,
      "width": 455.0,
      "height": 187.5,
      "text": "Has its own connection\nto that same knowledge base.\nTest its answers separately.",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "t11",
      "type": "text",
      "x": 60,
      "y": 580,
      "width": 1357.2,
      "height": 72.5,
      "text": "Reuse the knowledge base. Keep each agent's connection and access clear.",
      "fontSize": 29,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "t12",
