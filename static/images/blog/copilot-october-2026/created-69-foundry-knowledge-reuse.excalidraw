    },
    {
      "id": "t7",
      "type": "text",
      "x": 573,
      "y": 335,
      "width": 487.5,
      "height": 187.5,
      "text": "Sources and retrieval settings\nare maintained in Foundry.\nOne reusable knowledge base.",
      "fontSize": 25,
      "fontFamily": 2,
