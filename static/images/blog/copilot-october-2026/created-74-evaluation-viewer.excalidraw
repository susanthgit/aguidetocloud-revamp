      "width": 304.2,
      "height": 65.0,
      "text": "EVALUATION RESULTS",
      "fontSize": 26,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "t7",
      "type": "text",
      "x": 573,
      "y": 335,
      "width": 422.5,
      "height": 187.5,
      "text": "Show what the tests found.\nGive reviewers evidence\nto inspect and discuss.",
      "fontSize": 25,
      "fontFamily": 2,
