    },
    {
      "id": "t10",
      "type": "text",
      "x": 1063,
      "y": 335,
      "width": 471.25,
      "height": 187.5,
      "text": "Can see evaluation results\nwithout agent-editing rights.\nCan raise review questions.",
      "fontSize": 25,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "t11",
      "type": "text",
      "x": 60,
      "y": 580,
      "width": 1131.0,
      "height": 72.5,
      "text": "Reviewing the evidence is different from changing the agent.",
      "fontSize": 29,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "t12",
      "type": "text",
      "x": 60,
      "y": 685,
      "width": 1341.6000000000001,
      "height": 60.0,
      "text": "Conceptual role boundary, not a complete permissions matrix or a role-assignment test.",
