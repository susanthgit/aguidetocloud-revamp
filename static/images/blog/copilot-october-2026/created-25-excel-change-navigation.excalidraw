      "height": 60.0,
      "text": "IN THE WORKBOOK",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-7",
      "type": "text",
      "x": 765,
      "y": 246,
      "width": 610.08,
      "height": 180.0,
      "text": "The changed object is highlighted\nSheets, tables, ranges, charts and shapes\nInspect the result before relying on it",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-8",
      "type": "text",
      "x": 60,
      "y": 448,
      "width": 1054.62,
      "height": 67.5,
      "text": "A sheet name printed in a reply is not proof of a working link.",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-9",
      "type": "text",
      "x": 60,
      "y": 507,
      "width": 1254.8799999999999,
      "height": 57.5,
      "text": "Our capture did not expose a clickable reference; this explains the announced behaviour.",
      "fontSize": 23,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
