      "x": 765,
      "y": 246,
      "width": 565.4399999999999,
      "height": 180.0,
      "text": "Microsoft describes the Siri request:\n\"Hey Siri, ask Copilot\"\nNo simulated dashboard or answer shown",
      "fontSize": 24,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-8",
      "type": "text",
      "x": 60,
      "y": 448,
      "width": 870.48,
      "height": 67.5,
      "text": "Set up and familiarise yourself while safely parked.",
      "fontSize": 27,
      "fontFamily": 2,
      "strokeColor": "#000000",
      "textAlign": "left",
      "verticalAlign": "top"
    },
    {
      "id": "text-9",
      "type": "text",
      "x": 60,
      "y": 507,
      "width": 1283.4,
      "height": 57.5,
      "text": "Not tested in a car. Follow local road rules; do not interact with a screen while driving.",
      "fontSize": 23,
